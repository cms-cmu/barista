# ==============================================================================
# src/classifier/workflow/Snakefile
#
# Generic HCR Neural Network Classifier Training, Evaluation & Plotting Pipeline
# ==============================================================================
#
# OVERVIEW & OBJECTIVE:
# Provides the central, framework-level Snakemake workflow for training,
# evaluating, and diagnosing PyTorch machine learning classifiers within the
# Barista / coffea4bees ecosystem (such as FvT and SvB models).
#
# DESIGN & ARCHITECTURE:
# The workflow is parameterized and wildcard-driven over `{model_dir}`, enabling
# it to serve both single-model standalone workflows (e.g. Phase C nominal FvT,
# Phase D nominal SvB) and multi-model / multi-subsample workflows (e.g. Stage C
# background systematic pseudo-experiments across 16 independent slices):
#
#   1. Standalone Single-Model Mode:
#      - Triggered directly or via coordinator Snakefiles (Snakefile_PhaseC.smk,
#        Snakefile_PhaseD.smk) with a single model configuration.
#      - Evaluates the default target `rule all` producing model training, yields,
#        evaluation friend trees, and diagnostic plots for one model.
#   2. Multi-Model Mode (Wildcard Resolution):
#      - Consumer workflows define arbitrary model target paths of the form
#        `{output_dir}/mix_{m}/train.done` or `{output_dir}/mix_{m}/evaluate.done`.
#      - Automatically resolves local staged configs ({model_dir}/wfs/train.yml,
#        {model_dir}/common.yml) and custom template mappings (config["train_templates"]).
#
# CORE PIPELINE RULES:
#   - `rule train`: Trains the PyTorch neural network via `src.classifier.task.main`
#     using GPU resources and HCR datasets. Generates model checkpoint & train.done.
#   - `rule yields`: Produces HTML/JSON reports summarizing loaded event yields and
#     normalization ratios (e.g. d4/d3, t4/t3).
#   - `rule evaluate`: Runs batched GPU inference over collision data to stream
#     classifier transfer weights directly into ROOT friend trees on EOS.
#   - `rule analyze`: Evaluates ROC curves, loss histories, and training metrics.
#   - `rule plot_inputs_raw`: Plots raw input kinematic and b-tagging distributions.
#   - `rule plot_inputs_dataprep`: Plots embedded normalized input features from dataPrep().
#   - `rule plot_weights`: Plots model event weights and closure distributions.
#
# USAGE:
#   snakemake --snakefile src/classifier/workflow/Snakefile \
#             --configfile <path/to/workflow_config.yml> \
#             [--cores N]
# ==============================================================================

from datetime import datetime
import os

DATE = datetime.now().strftime("%Y%m%d")

EOS_BASE = config.get("eos_base", "")
LABEL    = config.get("label", "classifier")


def _r(val):
    if isinstance(val, str):
        return val.format(eos_base=EOS_BASE, label=LABEL)
    return val


CLASSIFIER_CONFIG_PATHS = config.get("classifier_config_paths", "coffea4bees")
WFS_BASE                = config.get("wfs_base", "")
OUTPUT_DIR              = _r(config.get("output_dir", f"output/{LABEL}")).rstrip("/")
PLOT_INPUTS             = bool(config.get("plot_inputs", False))
PLOT_WEIGHTS            = bool(config.get("plot_weights", False))
EVALUATE                = bool(config.get("evaluate", True))

MODEL          = _r(config.get("model", f"{EOS_BASE}/classifier/{LABEL}"))
TRAIN_TEMPLATE = _r(config.get("train_template", f"model: {MODEL}"))
EVAL_TEMPLATE  = _r(config.get("eval_template", ""))
METADATA       = config.get("metadata", "")
FRIEND         = _r(config.get("friend", ""))

PLOT_BASE = config.get("plot_base", "")
COMMON    = _r(config.get("common", f"{WFS_BASE}/../common.yml" if WFS_BASE else "common.yml"))

# Split evaluation: {split name: {dataset option: value}}. Each split is a separate (smaller) evaluate
# job over the datasets its options select, written to <IO output>/split_<name>; evaluate_combine
# then sums the split friend trees into the usual <IO output>/result.json (analysis.0.merged), so
# consumers are unchanged. The options are set on every dataset module of evaluate.yml, replacing
# any existing value: e.g. {detector: {--data-source: detector, --mc-processes: ""}} (an empty
# string passes the flag with no values, null removes it). The splits must not overlap.
EVAL_SPLITS = config.get("eval_splits") or {}


def _get_plot_root(wildcards):
    if PLOT_BASE and not str(PLOT_BASE).startswith("root://"):
        return f"{PLOT_BASE}/{DATE}_{os.path.basename(wildcards.model_dir)}"
    return f"{wildcards.model_dir}/plots"


def _get_plot_target(wildcards, kind):
    root = _get_plot_root(wildcards)
    return f"{root}/{kind}" if kind else root

# ── Cluster resource defaults ────────────────────────────────────────────────
default_gpu_partition = config.get("gpu_partition", "work")
default_gpu_account   = config.get("slurm_account", "")
# A quarter GPU on qos light by default (falcon: mps:25 = 20 GB of GPU memory). Heavier trainings
# (e.g. the 30x MvD/FvT, ~30 GB) ask for more in their workflow config: gpu_gres "mps:50" with
# gpu_qos "medium" -- falcon's light QOS caps a job at mps:25 (QOSMaxGRESPerJob), so the two go
# together (d67ba6e2 paired mps:50 with light and every sbatch was rejected). Not in the falcon
# profile: a profile set-resources would override every workflow config.
default_gpu_gres      = config.get("gpu_gres", "mps:25")
default_gpu_mem       = config.get("gpu_mem", 64000)
default_gpu_qos       = config.get("gpu_qos", "light")

# ── Container images ──────────────────────────────────────────────────────────

CLASSIFIER = "/cvmfs/unpacked.cern.ch/gitlab-registry.cern.ch/cms-cmu/barista:classifier_latest"
ANALYSIS_CONTAINER = "/cvmfs/unpacked.cern.ch/gitlab-registry.cern.ch/cms-cmu/barista:latest"

INIT = "set -e && set +u && { [ -f /entrypoint.sh ] && source /entrypoint.sh || true; } && set -u && export PYTHONUNBUFFERED=1 && { ulimit -n 65536 2>/dev/null || true; }"

# ── Wildcard resolution helpers ──────────────────────────────────────────────

wildcard_constraints:
    model_dir = ".+"


def _get_train_wf(wildcards):
    if WFS_BASE and os.path.exists(f"{WFS_BASE}/train.yml"):
        return f"{WFS_BASE}/train.yml"
    return f"{wildcards.model_dir}/wfs/train.yml"


def _get_eval_wf(wildcards):
    if WFS_BASE and os.path.exists(f"{WFS_BASE}/evaluate.yml"):
        return f"{WFS_BASE}/evaluate.yml"
    return f"{wildcards.model_dir}/wfs/evaluate.yml"


def _get_common(wildcards):
    if config.get("common") and os.path.exists(config["common"]):
        return config["common"]
    custom = f"{wildcards.model_dir}/common.yml"
    if os.path.exists(custom):
        return custom
    return custom


def _get_train_template(wildcards):
    template_fn = config.get("train_template_fn")
    if callable(template_fn):
        return template_fn(wildcards)
    templates = config.get("train_templates")
    if isinstance(templates, dict) and wildcards.model_dir in templates:
        return templates[wildcards.model_dir]
    if isinstance(TRAIN_TEMPLATE, str) and "{model_dir}" in TRAIN_TEMPLATE:
        return TRAIN_TEMPLATE.format(model_dir=wildcards.model_dir, eos_base=EOS_BASE, label=LABEL)
    return TRAIN_TEMPLATE


def _get_eval_template(wildcards):
    template_fn = config.get("eval_template_fn")
    if callable(template_fn):
        return template_fn(wildcards)
    templates = config.get("eval_templates")
    if isinstance(templates, dict) and wildcards.model_dir in templates:
        return templates[wildcards.model_dir]
    if isinstance(EVAL_TEMPLATE, str) and "{model_dir}" in EVAL_TEMPLATE:
        return EVAL_TEMPLATE.format(model_dir=wildcards.model_dir, eos_base=EOS_BASE, label=LABEL)
    return EVAL_TEMPLATE


def _get_model_path(wildcards):
    model_fn = config.get("model_fn")
    if callable(model_fn):
        return model_fn(wildcards)
    models = config.get("models")
    if isinstance(models, dict) and wildcards.model_dir in models:
        return models[wildcards.model_dir]
    if isinstance(MODEL, str) and "{model_dir}" in MODEL:
        return MODEL.format(model_dir=wildcards.model_dir, eos_base=EOS_BASE, label=LABEL)
    return MODEL


def _get_friend_path(wildcards):
    friend_fn = config.get("friend_fn")
    if callable(friend_fn):
        return friend_fn(wildcards)
    friends = config.get("friends_dict") or config.get("friends")
    if isinstance(friends, dict) and wildcards.model_dir in friends:
        return friends[wildcards.model_dir]
    if isinstance(FRIEND, str) and "{model_dir}" in FRIEND:
        return FRIEND.format(model_dir=wildcards.model_dir, eos_base=EOS_BASE, label=LABEL)
    return FRIEND


# ── Target Rules ─────────────────────────────────────────────────────────────

def _all_targets():
    targets = [
        f"{OUTPUT_DIR}/train.done",
        f"{OUTPUT_DIR}/yields.html",
        f"{OUTPUT_DIR}/analyze.done",
        f"{OUTPUT_DIR}/gallery.done",
    ]
    if EVALUATE:
        targets.append(f"{OUTPUT_DIR}/evaluate.done")
    if PLOT_INPUTS:
        targets += [
            f"{OUTPUT_DIR}/plot_inputs_raw.done",
            f"{OUTPUT_DIR}/plot_inputs_dataprep.done",
        ]
    if PLOT_WEIGHTS:
        targets += [
            f"{OUTPUT_DIR}/plot_weights.done",
        ]
    return targets


rule all:
    input: _all_targets()


rule train:
    retries: 0 if config.get("test", False) else config.get("retries", 3)
    input:
        wf     = _get_train_wf,
        common = _get_common,
    output:
        flag = "{model_dir}/train.done",
    log:
        "{model_dir}/train.log",
    container: CLASSIFIER
    resources:
        runtime         = config.get("train_runtime", 480),
        mem_mb          = config.get("train_mem", default_gpu_mem),
        gres            = config.get("train_gres", default_gpu_gres),
        qos             = config.get("train_qos", default_gpu_qos),
        slurm_partition = config.get("train_partition", default_gpu_partition),
        slurm_account   = config.get("slurm_account", default_gpu_account),
    threads: config.get("train_threads", 8)
    params:
        init                    = INIT,
        classifier_config_paths = CLASSIFIER_CONFIG_PATHS,
        template_str            = _get_train_template,
        yields                  = lambda wildcards: f"{wildcards.model_dir}/yields_loaded.json",
    shell:
        """
        {params.init} && \
        mkdir -p $(dirname {output.flag}) $(dirname {log}) && \
        rm -f {params.yields} && \
        set +u && \
        if [ -z "$X509_USER_PROXY" ] && [ -f ./proxy/x509_proxy ]; then \
            export X509_USER_PROXY="$PWD/proxy/x509_proxy"; \
        fi && \
        set -u && \
        HCR_YIELDS_FILE=$PWD/{params.yields} \
        CLASSIFIER_CONFIG_PATHS={params.classifier_config_paths} \
        python -m src.classifier.task.main \
            template "{{{params.template_str}}}" {input.wf} \
            -from {input.common} \
            -flag debug \
            2>&1 | tee -a {log}
        test ${{PIPESTATUS[0]}} -eq 0
        touch {output.flag}
        """


rule yields:
    input:
        "{model_dir}/train.done",
    output:
        html = "{model_dir}/yields.html",
        json = "{model_dir}/yields.json",
    log:
        "{model_dir}/yields.log",
    params:
        loaded    = lambda wildcards: f"{wildcards.model_dir}/yields_loaded.json",
        train_log = lambda wildcards: f"{wildcards.model_dir}/train.log",
        ratios    = " ".join(f'--ratio "{r}"' for r in config.get("yields_ratio", []) or []),
        title     = lambda wildcards: os.path.basename(wildcards.model_dir),
    shell:
        """
        python3 src/classifier/yields_report.py --yields {params.loaded} --log {params.train_log} \
            {params.ratios} --title {params.title} -o {output.html} --json {output.json} 2>&1 | tee {log}
        """


rule analyze:
    input:
        "{model_dir}/train.done",
    output:
        flag = "{model_dir}/analyze.done",
    log:
        "{model_dir}/analyze.log",
    container: ANALYSIS_CONTAINER
    resources:
        runtime = 60,
        mem_mb  = 16000,
    threads: 4
    params:
        init                    = INIT,
        classifier_config_paths = CLASSIFIER_CONFIG_PATHS,
        model                   = _get_model_path,
        plot                    = lambda wildcards: _get_plot_target(wildcards, "analyze"),
    shell:
        """
        {params.init} && \
        mkdir -p $(dirname {output.flag}) $(dirname {log}) && \
        CLASSIFIER_CONFIG_PATHS={params.classifier_config_paths} \
        python -m src.classifier.task.main analyze \
            {params.model}/result.json \
            -analysis HCR.LossROC \
            -setting IO "output: {params.plot}" \
            -setting IO "report: ." \
            2>&1 | tee -a {log}
        test ${{PIPESTATUS[0]}} -eq 0
        touch {output.flag}
        """


EVAL_SHELL = """
        {params.init} && \
        mkdir -p $(dirname {output.flag}) $(dirname {log}) && \
        set +u && \
        if [ -z "$X509_USER_PROXY" ] && [ -f ./proxy/x509_proxy ]; then \
            export X509_USER_PROXY="$PWD/proxy/x509_proxy"; \
        fi && \
        set -u && \
        TMP_BASE="${{SLURM_TMPDIR:-${{LOCAL:-${{_CONDOR_SCRATCH_DIR:-${{TMPDIR:-/tmp}}}}}}}}" && \
        SCRATCH_DIR=$(mktemp -d -p "$TMP_BASE" eval_scratch_XXXXXX) && \
        trap 'rm -rf "$SCRATCH_DIR"' EXIT && \
        EVAL_SCRATCH="$SCRATCH_DIR" \
        CLASSIFIER_CONFIG_PATHS={params.classifier_config_paths} \
        python -m src.classifier.task.main \
            template "{{{params.template_str}}}" {input.eval_wf} \
            -from {input.common} \
            -flag debug \
            2>&1 | tee -a {log}
        test ${{PIPESTATUS[0]}} -eq 0
        touch {output.flag}
        """

if not EVAL_SPLITS:

    rule evaluate:
        retries: 0 if config.get("test", False) else config.get("retries", 3)
        input:
            train_flag = "{model_dir}/train.done",
            eval_wf    = _get_eval_wf,
            common     = _get_common,
        output:
            flag = "{model_dir}/evaluate.done",
        log:
            "{model_dir}/evaluate.log",
        container: CLASSIFIER
        resources:
            runtime         = config.get("eval_runtime", 480),
            mem_mb          = config.get("eval_mem", default_gpu_mem),
            gres            = config.get("eval_gres", default_gpu_gres),
            qos             = config.get("eval_qos", default_gpu_qos),
            slurm_partition = config.get("eval_partition", default_gpu_partition),
            slurm_account   = config.get("slurm_account", default_gpu_account),
        threads: config.get("eval_threads", 8)
        params:
            init                    = INIT,
            classifier_config_paths = CLASSIFIER_CONFIG_PATHS,
            template_str            = _get_eval_template,
        shell:
            EVAL_SHELL

else:

    wildcard_constraints:
        split = "|".join(map(str, EVAL_SPLITS)),

    rule evaluate_split_wf:
        input:
            eval_wf = _get_eval_wf,
        output:
            eval_wf = "{model_dir}/wfs/evaluate.split_{split}.yml",
            out_dir = "{model_dir}/wfs/evaluate.split_{split}.out",
        params:
            template_str = _get_eval_template,
        run:
            import sys
            import yaml

            sys.path.insert(0, os.getcwd())
            from src.classifier.workflow.eval_splits import split_workflow

            with open(input.eval_wf) as f:
                wf = yaml.safe_load(f)
            wf, out_dir = split_workflow(
                wf, wildcards.split, EVAL_SPLITS[wildcards.split], params.template_str
            )
            with open(output.eval_wf, "w") as f:
                yaml.safe_dump(wf, f, sort_keys=False, width=float("inf"))
            with open(output.out_dir, "w") as f:
                f.write(out_dir + "\n")

    rule evaluate_split:
        retries: 0 if config.get("test", False) else config.get("retries", 3)
        input:
            train_flag = "{model_dir}/train.done",
            eval_wf    = "{model_dir}/wfs/evaluate.split_{split}.yml",
            common     = _get_common,
        output:
            flag = "{model_dir}/evaluate.split_{split}.done",
        log:
            "{model_dir}/evaluate.split_{split}.log",
        container: CLASSIFIER
        resources:
            runtime         = config.get("eval_runtime", 480),
            mem_mb          = config.get("eval_split_mem", config.get("eval_mem", default_gpu_mem)),
            gres            = config.get("eval_gres", default_gpu_gres),
            qos             = config.get("eval_qos", default_gpu_qos),
            slurm_partition = config.get("eval_partition", default_gpu_partition),
            slurm_account   = config.get("slurm_account", default_gpu_account),
        threads: config.get("eval_threads", 8)
        params:
            init                    = INIT,
            classifier_config_paths = CLASSIFIER_CONFIG_PATHS,
            template_str            = _get_eval_template,
        shell:
            EVAL_SHELL

    # Not a GPU rule: on nautilus it runs as a small CPU pod in the classifier image (it reads and
    # writes result.json on EOS with the barista Friend code, which the orchestrator image lacks).
    rule evaluate_combine:
        input:
            flags    = expand("{{model_dir}}/evaluate.split_{split}.done", split=list(EVAL_SPLITS)),
            out_dirs = expand("{{model_dir}}/wfs/evaluate.split_{split}.out", split=list(EVAL_SPLITS)),
        output:
            flag = "{model_dir}/evaluate.done",
        log:
            "{model_dir}/evaluate.log",
        container: CLASSIFIER
        resources:
            runtime = 60,
            mem_mb  = 4000,
        params:
            init = INIT,
        shell:
            """
            {params.init} && \
            set +u && \
            if [ -z "$X509_USER_PROXY" ] && [ -f ./proxy/x509_proxy ]; then \
                export X509_USER_PROXY="$PWD/proxy/x509_proxy"; \
            fi && \
            set -u && \
            PYTHONPATH=$PWD python -m src.classifier.workflow.eval_splits $(cat {input.out_dirs}) \
                2>&1 | tee -a {log}
            test ${{PIPESTATUS[0]}} -eq 0
            touch {output.flag}
            """


rule plot_inputs_raw:
    input:
        "{model_dir}/train.done",
    output:
        flag = "{model_dir}/plot_inputs_raw.done",
    log:
        "{model_dir}/plot_inputs_raw.log",
    container: ANALYSIS_CONTAINER
    resources:
        runtime = 60,
        mem_mb  = 8000,
    threads: 1
    params:
        init     = INIT,
        model    = _get_model_path,
        metadata = METADATA,
        plot     = lambda wildcards: _get_plot_target(wildcards, "inputs_raw"),
    shell:
        """
        {params.init} && \
        python src/classifier/plot_inputs.py \
            --mode raw \
            --checkpoint {params.model} \
            --metadata {params.metadata} \
            --output-dir {params.plot} \
            2>&1 | tee -a {log}
        touch {output.flag}
        """


rule plot_inputs_dataprep:
    input:
        "{model_dir}/train.done",
    output:
        flag = "{model_dir}/plot_inputs_dataprep.done",
    log:
        "{model_dir}/plot_inputs_dataprep.log",
    container: ANALYSIS_CONTAINER
    resources:
        runtime = 60,
        mem_mb  = 8000,
    threads: 1
    params:
        init     = INIT,
        model    = _get_model_path,
        metadata = METADATA,
        plot     = lambda wildcards: _get_plot_target(wildcards, "inputs_dataprep"),
    shell:
        """
        {params.init} && \
        python src/classifier/plot_inputs.py \
            --mode dataprep \
            --checkpoint {params.model} \
            --metadata {params.metadata} \
            --output-dir {params.plot} \
            2>&1 | tee -a {log}
        touch {output.flag}
        """


rule plot_weights:
    input:
        "{model_dir}/train.done",
    output:
        flag = "{model_dir}/plot_weights.done",
    log:
        "{model_dir}/plot_weights.log",
    container: ANALYSIS_CONTAINER
    resources:
        runtime = 60,
        mem_mb  = 8000,
    threads: 1
    params:
        init         = INIT,
        model        = _get_model_path,
        metadata     = METADATA,
        plot         = lambda wildcards: _get_plot_target(wildcards, "weights"),
        wfs_base     = _get_train_wf,
        template_str = _get_train_template,
        friend_path  = _get_friend_path,
    shell:
        """
        {params.init} && \
        python src/classifier/plot_weights.py \
            --checkpoint {params.model} \
            --metadata {params.metadata} \
            --output-dir {params.plot} \
            --wfs-base $(dirname {params.wfs_base}) \
            --template-str "{params.template_str}" \
            --friend-path "{params.friend_path}" \
            2>&1 | tee -a {log}
        touch {output.flag}
        """


localrules: yields, classifier_gallery
if EVAL_SPLITS:
    localrules: evaluate_split_wf


def _gallery_inputs(wildcards):
    deps = [f"{wildcards.model_dir}/analyze.done"]
    if PLOT_INPUTS:
        deps.append(f"{wildcards.model_dir}/plot_inputs_raw.done")
        deps.append(f"{wildcards.model_dir}/plot_inputs_dataprep.done")
    if PLOT_WEIGHTS:
        deps.append(f"{wildcards.model_dir}/plot_weights.done")
    return deps


rule classifier_gallery:
    input:
        _gallery_inputs,
    output:
        flag = "{model_dir}/gallery.done",
    params:
        plot_root = _get_plot_root,
        title     = lambda wildcards: f"Classifier Diagnostics - {os.path.basename(wildcards.model_dir)}",
    shell:
        """
        python src/plotting/make_gallery.py {params.plot_root} --title "{params.title}"
        touch {output.flag}
        """

