#!/usr/bin/env bash

# --- Configuration ---
# Image Definitions
COFFEA_IMAGE="${COFFEA_IMAGE:-docker://gitlab-registry.cern.ch/cms-cmu/barista:latest}"
DEV_COFFEA0_7_IMAGE="docker://gitlab-registry.cern.ch/cms-cmu/barista:coffea0_7_latest"
COMBINE_IMAGE="docker://gitlab-registry.cern.ch/cms-analysis/general/combine-container:CMSSW_14_1_0_pre4-combine_v10.6.0-harvester_v3.1.0"
SNAKEMAKE_IMAGE="docker://gitlab-registry.cern.ch/cms-cmu/barista:reana_latest"   ### depracated, use local Pixi environment instead
CLASSIFIER_IMAGE="docker://gitlab-registry.cern.ch/cms-cmu/barista:classifier_latest"
BRILCALC_IMAGE="docker://gitlab-registry.cern.ch/cms-cloud/brilws-docker:latest"

# Resolve CVMFS paths if available
_resolve_cvmfs() {
    local img="$1"
    # Access /cvmfs/unpacked.cern.ch to trigger autofs mount if available
    ls /cvmfs/unpacked.cern.ch >/dev/null 2>&1
    local cvmfs_path="/cvmfs/unpacked.cern.ch/${img#docker://}"
    if [ -e "$cvmfs_path" ]; then
        echo "$cvmfs_path"
    else
        echo "$img"
    fi
}
if [ -d '/cvmfs' ]; then
    COFFEA_IMAGE=$(_resolve_cvmfs "$COFFEA_IMAGE")
    DEV_COFFEA0_7_IMAGE=$(_resolve_cvmfs "$DEV_COFFEA0_7_IMAGE")
    COMBINE_IMAGE=$(_resolve_cvmfs "$COMBINE_IMAGE")
    SNAKEMAKE_IMAGE=$(_resolve_cvmfs "$SNAKEMAKE_IMAGE")
    CLASSIFIER_IMAGE=$(_resolve_cvmfs "$CLASSIFIER_IMAGE")
    BRILCALC_IMAGE=$(_resolve_cvmfs "$BRILCALC_IMAGE")
fi

# --- Helpers ---
info() { echo -e "\033[1;34m[INFO]\033[0m $1" >&2; }
error() { echo -e "\033[1;31m[ERROR]\033[0m $1" >&2; }
warning() { echo -e "\033[1;33m[WARNING]\033[0m $1" >&2; }

# True if <path> (or <src>:<dst>) is already part of APPTAINER_BINDPATH
_bind_listed() {
    case ",${APPTAINER_BINDPATH:-}," in
        *",$1,"*) return 0 ;;
        *) return 1 ;;
    esac
}

check_apptainer() {
    command -v apptainer >/dev/null 2>&1 || { error "Apptainer is not installed. Aborting."; exit 1; }
}

add_x509_proxy_flags() {
    local HOST="$1"
    local -n FLAGS_REF="$2"

    case "$HOST" in
        *cmslpc*|*lxplus*|*falcon*|*rogue*|*bridges2*|*psc*)
            local PROXY="${PWD}/proxy/x509_proxy"
            mkdir -p proxy
            touch "$PROXY"
            export X509_USER_PROXY="$PROXY"
            FLAGS_REF+=( -B "$PROXY":"$PROXY" --env X509_USER_PROXY="$PROXY" )
            ;;
    esac
}

# --- lxplus (CERN HTCondor) Specific Logic ---
LXPLUS_KRB_CACHE="/tmp/${USER}/krb5cc_barista"

setup_lxplus_kerberos() {
    # The login-session Kerberos cache lives on a tmpfs that vanishes at logout; copy it to a stable
    # file so a long-running shared-dask daemon keeps a valid ticket, and store the batch credential in
    # the CERN credd so jobs with MY.SendCredential can be submitted from inside the container (whose
    # condor_submit cannot run the host-only credential producer).
    [[ $(hostname) != *lxplus* ]] && return 0
    local _src="${KRB5CCNAME#FILE:}"
    [ -z "$_src" ] && _src="/run/user/$(id -u)/krb5cc"
    mkdir -p "/tmp/${USER}"
    if [ -r "$_src" ] && [ "$_src" != "$LXPLUS_KRB_CACHE" ]; then
        cp "$_src" "${LXPLUS_KRB_CACHE}.tmp" && chmod 600 "${LXPLUS_KRB_CACHE}.tmp" && mv -f "${LXPLUS_KRB_CACHE}.tmp" "$LXPLUS_KRB_CACHE"
    fi
    if command -v condor_store_cred >/dev/null 2>&1; then
        if ! { [ -x /usr/bin/batch_krb5_credential ] && /usr/bin/batch_krb5_credential 2>/dev/null | condor_store_cred add-krb -i - >/dev/null 2>&1; }; then
            condor_store_cred add-krb -i "$_src" >/dev/null 2>&1 \
                || warning "condor_store_cred failed: HTCondor jobs with MY.SendCredential may not start (run: condor_store_cred add-krb -i $_src)"
        fi
    fi
}

add_lxplus_condor_flags() {
    # Make the CERN HTCondor client work inside the analysis container: host condor config + Kerberos,
    # skip the host-only local-config hook, pin the user's schedd/credd, and tell runner.py the site.
    local HOST="$1"
    local -n LX_FLAGS_REF="$2"
    [[ $HOST != *lxplus* ]] && return 0
    setup_lxplus_kerberos
    local _schedd _credd
    _schedd=$(condor_config_val SCHEDD_HOST 2>/dev/null)
    _credd=$(condor_config_val CREDD_HOST 2>/dev/null)
    _bind_listed /afs || LX_FLAGS_REF+=( -B /afs )
    LX_FLAGS_REF+=( -B /etc/condor -B /etc/sysconfig/ngbauth-submit
        --env KRB5CCNAME="FILE:${LXPLUS_KRB_CACHE}"
        --env SKIP_LOCAL_CONFIG_FILE=TRUE
        --env _CONDOR_SEC_CREDENTIAL_PRODUCER=CREDENTIAL_ALREADY_STORED
        --env COFFEA_IMAGE_FULL="$COFFEA_IMAGE"
        --env BARISTA_SITE=lxplus
    )
    [ -n "$_schedd" ] && LX_FLAGS_REF+=( --env _CONDOR_SCHEDD_HOST="$_schedd" )
    [ -n "$_credd" ] && LX_FLAGS_REF+=( --env _CONDOR_CREDD_HOST="$_credd" )
    # Interim dask_lxplus install (until the analysis image ships it): see `run_container lxplus-setup`
    local _site="${BARISTA_LXPLUS_SITE:-$PWD/.lxplus_site}"
    if [ -d "$_site" ]; then
        LX_FLAGS_REF+=( --env PYTHONPATH="$(readlink -f "$_site")" )
    fi
}

lxplus_check_scheduler_port() {
    # CERN opens the standard Dask scheduler port (8786) for inbound connections on lxplus nodes, but not
    # arbitrary ports, and some nodes block even 8786 (seen on lxplus963: HTCondor workers die with
    # "Timed out trying to connect to tcp://<ip>:8786"). lxplus VMs on the same network can still reach such a
    # node, so the probe is only trusted when it comes from a node on a different network. Cached per node/port.
    local port="${1:-8786}"
    local host_short; host_short=$(hostname -s)
    local ip; ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    [ -n "$ip" ] || return 0
    local my_net="${ip%.*.*}"
    local cache="/tmp/${USER}/lxplus_portcheck_${host_short}_${port}"
    mkdir -p "/tmp/${USER}"
    if [ ! -f "$cache" ]; then
        # Temporary listener; if the port is busy (e.g. a running daemon) skip the check.
        python3 -c "import socket,time; s=socket.socket(); s.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1); s.bind(('$ip',$port)); s.listen(1); time.sleep(90)" >/dev/null 2>&1 &
        local lpid=$!
        sleep 1
        kill -0 "$lpid" 2>/dev/null || return 0
        # Probe from lxplus pool nodes on another /16 network (DNS round-robin alone tends to return
        # same-network VMs, which are allowed through where batch nodes are not).
        local res="" probe
        for probe in $(getent ahostsv4 lxplus.cern.ch | awk '{print $1}' | sort -u | grep -v "^${my_net}\." | shuf | head -4); do
            res=$(ssh -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=10 "$probe" \
                  "timeout 5 bash -c 'echo > /dev/tcp/$ip/$port' 2>/dev/null && echo open || echo blocked" 2>/dev/null | tail -1)
            case "$res" in open|blocked) break ;; esac
        done
        kill "$lpid" 2>/dev/null
        case "$res" in
            open|blocked) echo "$res" > "$cache" ;;
            *) return 0 ;;   # no pool node on another network reachable over ssh: inconclusive, do not cache
        esac
    fi
    if [ "$(cat "$cache")" = "blocked" ]; then
        warning "Inbound TCP port ${port} on $(hostname) (${ip}) is blocked from other CERN networks."
        warning "HTCondor Dask workers cannot reach a scheduler started here. Log in to another lxplus node"
        warning "(e.g. lxplus954 accepted worker connections) and retry; '$0 lxplus-check' verifies a node from a batch job."
        return 1
    fi
    return 0
}

run_lxplus_check() {
    # Definitive check: an HTCondor job connects back to a listener on this node's scheduler port.
    [[ $(hostname) != *lxplus* ]] && { error "lxplus-check is only meaningful on lxplus."; exit 1; }
    local port="${1:-8786}"
    local ip; ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    setup_lxplus_kerberos
    local dir="$HOME/.barista/lxplus_check_$(date +%s)"
    mkdir -p "$dir" || { error "cannot create $dir"; exit 1; }
    python3 -c "import socket,time; s=socket.socket(); s.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1); s.bind(('$ip',$port)); s.listen(1); time.sleep(600)" >/dev/null 2>&1 &
    local lpid=$!
    sleep 1
    kill -0 "$lpid" 2>/dev/null || { error "Port ${port} is already in use on $(hostname) (a Dask scheduler running?). Stop it or pass another port."; exit 1; }
    printf '#!/bin/bash\necho "probe from $(hostname) $(hostname -I)"\ntimeout 8 bash -c "echo > /dev/tcp/%s/%s" 2>/dev/null && echo "RESULT: OPEN" || echo "RESULT: BLOCKED"\n' "$ip" "$port" > "$dir/probe.sh"
    chmod +x "$dir/probe.sh"
    cat > "$dir/probe.sub" <<EOF
universe = vanilla
executable = $dir/probe.sh
output = $dir/probe.\$(ClusterId).out
error = $dir/probe.\$(ClusterId).err
log = $dir/probe.\$(ClusterId).log
MY.SendCredential = True
+JobFlavour = "espresso"
request_memory = 512MB
queue
EOF
    info "Submitting a probe job that connects back to ${ip}:${port} (usually 1-3 min)..."
    local cid; cid=$(condor_submit "$dir/probe.sub" 2>&1 | sed -n 's/.*cluster \([0-9]*\).*/\1/p')
    [ -n "$cid" ] || { error "condor_submit failed"; kill "$lpid" 2>/dev/null; exit 1; }
    local waited=0
    while [ -n "$(condor_q "$cid" -af JobStatus 2>/dev/null)" ] && [ $waited -lt 570 ]; do sleep 15; waited=$((waited+15)); done
    kill "$lpid" 2>/dev/null
    local res; res=$(grep -o "RESULT: .*" "$dir/probe.$cid.out" 2>/dev/null)
    case "$res" in
        *OPEN*)    info "Port ${port} on $(hostname) is reachable from HTCondor workers: $(head -1 "$dir/probe.$cid.out")"; echo open > "/tmp/${USER}/lxplus_portcheck_$(hostname -s)_${port}" ;;
        *BLOCKED*) error "Port ${port} on $(hostname) is BLOCKED for HTCondor workers ($(head -1 "$dir/probe.$cid.out")). Use another lxplus node."; echo blocked > "/tmp/${USER}/lxplus_portcheck_$(hostname -s)_${port}"; exit 1 ;;
        *)         warning "Probe job ${cid} did not finish in time; check condor_q ${cid} and $dir" ;;
    esac
}

