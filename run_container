    local FLAGS=( -B "${PWD}:/srv" --pwd /srv/ -B /tmp:/tmp
        --env PYTHONPATH=/home/bril/.local/lib/python3.10/site-packages
        --env PYTHONHISTFILE=/srv/.python_history
    )

    if [ -z "$*" ]; then
        APPTAINER_SHELL=$(which bash) "${APPTAINER_CMD:-apptainer}" exec "${FLAGS[@]}" "${BRILCALC_IMAGE}" /bin/bash
    else
        APPTAINER_SHELL=$(which bash) "${APPTAINER_CMD:-apptainer}" exec "${FLAGS[@]}" "${BRILCALC_IMAGE}" /bin/bash -c "$*"
    fi
}

run_classifier() {
    check_apptainer
    info "Running Classifier container..."

    CACHE_BASE="$HOME/.cache/barista"
    local INIT_FILE="/entrypoint.sh"
    local USE_SLURM=false
    local IMAGE="$CLASSIFIER_IMAGE"
    touch "$PWD/.python_history"
    local FLAGS=( -B "$PWD":/srv --nv --pwd /srv
        --env PYTHONHISTFILE=/srv/.python_history
    )
    ulimit -n 65536

    # Detect if on FALCON (auto-enable SLURM)
    local HOST=$(hostname)
    if [[ $HOST == *falcon* ]]; then
        USE_SLURM=true
        info "FALCON cluster detected. Will submit jobs via SLURM."
    fi

    # Bind X509 proxy for XRootD authentication
    local PROXY="${PWD}/proxy/x509_proxy"
    if [ ! -f "$PROXY" ] && [ -n "${X509_USER_PROXY:-}" ] && [ -f "$X509_USER_PROXY" ]; then
        PROXY="$X509_USER_PROXY"
    fi
    if [ -f "$PROXY" ]; then
        FLAGS+=( -B "$PROXY":"$PROXY" --env X509_USER_PROXY="$PROXY" )
    fi

    # Collect user arguments
    local USER_CMD="$*"

    # lxplus: submit the command as an HTCondor GPU job (mirrors the falcon sbatch path below).
    # Without a command the classifier container opens locally (works on lxplus-gpu login nodes);
    # CONDOR_INTERACTIVE=1 requests an interactive GPU job instead.
    if [[ $HOST == *lxplus* ]] && [ -z "${_CONDOR_SCRATCH_DIR:-}" ] && { [ -n "$USER_CMD" ] || [ "${CONDOR_INTERACTIVE:-0}" = "1" ]; }; then
        local SUBMIT_ARGS=( --image "$IMAGE" --workdir "$(readlink -f "$PWD")" )
        [ -f "$PROXY" ] && SUBMIT_ARGS+=( --proxy "$(readlink -f "$PROXY")" )
        [ "${CONDOR_INTERACTIVE:-0}" = "1" ] && SUBMIT_ARGS+=( --interactive )
        [ "${CONDOR_DRY_RUN:-0}" = "1" ] && SUBMIT_ARGS+=( --dry-run )
        if [ -n "$USER_CMD" ]; then
            local USER_CMD_QUOTED
            USER_CMD_QUOTED=$(printf '%q ' "$@")
            SUBMIT_ARGS+=( --cmd "$USER_CMD_QUOTED" )
        fi
        setup_lxplus_kerberos
        info "lxplus detected. Submitting the classifier command as an HTCondor GPU job..."
        bash software/condor/submit_classifier_lxplus.sh "${SUBMIT_ARGS[@]}"
        return
    fi

    # GPU: Handle FALCON / BRIDGES2 interactive session
    if [ -z "$USER_CMD" ] && [[ $HOST == *falcon* || $HOST == *bridges2* || $HOST == *psc* ]]; then
        if [ -n "$SLURM_JOB_ID" ]; then
            # Already inside a job
            info "Inside Slurm Job ($SLURM_JOB_ID). Opening interactive GPU classifier shell..."
        else
            # Login node - submit interactive GPU job
            if [[ $HOST == *bridges2* || $HOST == *psc* ]]; then
                info "Not in a job. Launching interactive GPU Slurm session with --gres=gpu:1..."
                local ACCOUNT_ARG=()
                [ -n "${SLURM_ACCOUNT:-}" ] && ACCOUNT_ARG=( -A "${SLURM_ACCOUNT}" )
                srun --pty --partition=GPU-shared "${ACCOUNT_ARG[@]}" --time=04:00:00 --cpus-per-task=4 --mem=8000M --gres=gpu:1 "$0" classifier
            else
                info "Not in a job. Launching interactive GPU Slurm session with --gres=mps:20..."
                srun --pty --partition=work --time=04:00:00 --mem=4G --gres=mps:20 "$0" classifier
            fi
            return
        fi
    fi

    # Execute
    if [ "$USE_SLURM" = true ] && [ -n "$USER_CMD" ]; then
        # FALCON with command: submit to SLURM
        local SLURM_CONF="${SLURM_CONF:-software/slurm/slurm.conf}"
        mkdir -p slurm_logs
        local CMD="source $INIT_FILE && export PYTHONUNBUFFERED=1 && $USER_CMD"
        local SLURM_GRES_ARGS=( --gres=mps:20 )

        info "Submitting batch job to Slurm (config: $SLURM_CONF)..."
        { echo "#!/bin/bash"; cat "$SLURM_CONF"; echo "export X509_USER_PROXY=\"$PROXY\""; echo "${APPTAINER_CMD:-apptainer} exec ${FLAGS[@]} \"$IMAGE\" bash -c \"$CMD\""; } | sbatch "${SLURM_GRES_ARGS[@]}"
    elif [ -z "$USER_CMD" ]; then
        # Interactive (FALCON job or non-FALCON)
        APPTAINER_SHELL=$(which bash) "${APPTAINER_CMD:-apptainer}" exec "${FLAGS[@]}" "$IMAGE" bash --init-file "$INIT_FILE"
    else
        # Command execution
        APPTAINER_SHELL=$(which bash) "${APPTAINER_CMD:-apptainer}" exec "${FLAGS[@]}" "$IMAGE" bash -c "{ [ -f \"$INIT_FILE\" ] && source \"$INIT_FILE\"; } 2>/dev/null || true; $USER_CMD"
    fi
}

run_snakemake_container() {
    check_apptainer
    info "Running Snakemake container..."
    [[ -z "$1" ]] && { error "No arguments supplied."; show_help; exit 1; }
    [[ "$*" != *"--snakefile"* && "$*" != *"-s"* ]] && { error "--snakefile (-s) argument required."; exit 1; }

    APPTAINER_SHELL=$(which bash) "${APPTAINER_CMD:-apptainer}" exec -B "$PWD":/srv --pwd /srv/ "$SNAKEMAKE_IMAGE" /bin/bash -c "snakemake $*"
}

# --- Pixi / Snakemake Local ---

install_pixi() {
    if ! command -v pixi &> /dev/null; then
        if [ -x "${PIXI_DIR}/bin/pixi" ]; then
            export PATH="${PIXI_DIR}/bin:$PATH"
        else
            info "Installing Pixi to ${PIXI_DIR}..."
            export PIXI_HOME="${PIXI_DIR}"
            mkdir -p "${PIXI_DIR}"
            curl -fsSL https://pixi.sh/install.sh | bash >&2 || return 1
            export PATH="${PIXI_DIR}/bin:$PATH"
        fi
    fi
    command -v pixi &> /dev/null || return 1
}

run_snakemake() {
    local HOST
    HOST=$(hostname)
    
    if [[ $HOST == *bridges2* || $HOST == *psc* ]]; then
        if [ -z "$SLURM_JOB_ID" ]; then
            info "Not in a job on Bridges-2. Launching Snakemake scheduler inside interactive Slurm session..."
            local ACCOUNT_ARG=()
            [ -n "${SLURM_ACCOUNT:-}" ] && ACCOUNT_ARG=( -A "${SLURM_ACCOUNT}" )
            exec srun --pty --partition=RM-shared "${ACCOUNT_ARG[@]}" --time=04:00:00 --cpus-per-task=4 --mem=7800M "$0" snakemake "$@"
        fi
    fi

    # Note: on falcon, Snakemake runs directly on the login node (lightweight scheduler).
    # Heavy work is submitted to Slurm via the snakemake-executor-plugin-slurm.

    info "Running Snakemake with Pixi environment..."
    set -eo pipefail

    local REINSTALL=false
    local ARGS=()
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            --reinstall|--fresh) REINSTALL=true; shift ;;
            --help|-h) ARGS+=("--help"); shift ;;
            source) ARGS+=("$@"); break ;;
            *) ARGS+=("$1"); shift ;;
        esac
    done

    [[ ${#ARGS[@]} -eq 0 && "$REINSTALL" != true ]] && { error "No arguments supplied."; show_help; exit 1; }

    # Install Pixi
    install_pixi || { error "Pixi installation failed."; exit 1; }

    # Reinstall logic
    if [ "$REINSTALL" = true ]; then
        info "Cleaning up environment..."
        rm -rf .pixi
    fi

    # Install Environment
    pixi install || { error "Pixi install failed."; exit 1; }

    # Auto-inject cluster profile if user didn't specify one
    local HAS_PROFILE=false
    for arg in "${ARGS[@]}"; do
        if [[ "$arg" == "--profile" ]]; then
            HAS_PROFILE=true
            break
        fi
    done
    if [ "$HAS_PROFILE" = false ]; then
        # Use lpc_combine profile for combine/stat-analysis workflows; base profile for everything else.
        local AUTO_PROFILE="${PROFILE_DIR}/${CLUSTER_PROFILE}"
        local IS_COMBINE=false
        for arg in "${ARGS[@]}"; do
            if [[ "$arg" == *combine.smk* || "$arg" == *stat_analysis* || "$arg" == *Snakefile_combine* ]]; then
                IS_COMBINE=true
                break
            fi
        done
        if $IS_COMBINE && [ -d "${PROFILE_DIR}/${CLUSTER_PROFILE}_combine" ]; then
            AUTO_PROFILE="${PROFILE_DIR}/${CLUSTER_PROFILE}_combine"
        fi
        # Classifier training/evaluation workflows use the <profile>_gpu variant when one exists
        # (lxplus_gpu: GPU rules become HTCondor jobs, the rest runs locally).
        local IS_GPU_WORKFLOW=false
        for arg in "${ARGS[@]}"; do
            case "$arg" in
                *src/classifier/workflow/Snakefile*|*PhaseC_2*|*PhaseC_3*|*PhaseD_2*|*PhaseD_3*|*PhaseE_4*|*_training.smk|*Snakefile_PhaseC.smk|*Snakefile_PhaseD.smk)
                    IS_GPU_WORKFLOW=true
                    break
                    ;;
            esac
        done
        if $IS_GPU_WORKFLOW && [ -d "${PROFILE_DIR}/${CLUSTER_PROFILE}_gpu" ]; then
            AUTO_PROFILE="${PROFILE_DIR}/${CLUSTER_PROFILE}_gpu"
        fi
        if [ -d "$AUTO_PROFILE" ]; then
            info "Auto-injecting Snakemake profile: $AUTO_PROFILE"
            ARGS=("--profile" "$AUTO_PROFILE" "${ARGS[@]}")
        fi
    fi

    # Auto-inject Slurm account from $USER if the profile uses the slurm executor
    local ACTIVE_PROFILE_DIR=""
    local i=0
    while [ $i -lt ${#ARGS[@]} ]; do
        if [[ "${ARGS[$i]}" == "--profile" ]] && [ $((i+1)) -lt ${#ARGS[@]} ]; then
            ACTIVE_PROFILE_DIR="${ARGS[$((i+1))]}"
            break
        fi
        i=$((i+1))
    done
    if [ -n "$ACTIVE_PROFILE_DIR" ] && [ -f "$ACTIVE_PROFILE_DIR/config.yaml" ] && grep -q 'executor:.*slurm' "$ACTIVE_PROFILE_DIR/config.yaml"; then
        # Only inject slurm_account on clusters that require it (e.g., lxplus)
        # Falcon uses a default account with no partition association, so skip it
        local PROFILE_NAME
        PROFILE_NAME=$(basename "$ACTIVE_PROFILE_DIR")
        if [[ "$PROFILE_NAME" != "falcon" && "$PROFILE_NAME" != "bridges2" ]]; then
            info "Auto-injecting Slurm account: $USER"
            ARGS+=("--default-resources" "slurm_account=$USER")
        fi
    fi

    # Execute

    if [ "${ARGS[0]}" = "source" ]; then
        pixi run bash -c "${ARGS[*]}"
    else
        pixi run snakemake "${ARGS[@]}"
    fi
    info "Execution finished successfully!"
}

run_reana() {
    info "Running REANA client with Pixi environment..."
    set -eo pipefail

    local REINSTALL=false
    local ARGS=()
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            --reinstall|--fresh) REINSTALL=true; shift ;;
            --help|-h) ARGS+=("--help"); shift ;;
            source) ARGS+=("$@"); break ;;
            *) ARGS+=("$1"); shift ;;
        esac
    done

    [[ ${#ARGS[@]} -eq 0 && "$REINSTALL" != true ]] && { error "No arguments supplied."; show_help; exit 1; }

    # Install Pixi
    install_pixi || { error "Pixi installation failed."; exit 1; }

    # Reinstall logic
    if [ "$REINSTALL" = true ]; then
        info "Cleaning up environment..."
        rm -rf .pixi
    fi

    # Install Environment
    pixi install -e reana || { error "Pixi install failed."; exit 1; }

    # Execute
    export PYTHONNOUSERSITE=1
    if [ "${ARGS[0]}" = "source" ]; then
        pixi run -e reana bash -c "${ARGS[*]}"
    elif [ "${ARGS[0]}" = "run" ]; then
        # Split `run` into create+upload+start so upload failures don't abort the workflow.
        # reana-client run exits non-zero if any file fails to upload, which kills the pipeline.
        local RUN_ARGS=("${ARGS[@]:1}")  # everything after "run"
        local CREATE_ARGS=() UPLOAD_ARGS=() START_ARGS=() FOLLOW=false
        local i=0
        while [ $i -lt ${#RUN_ARGS[@]} ]; do
            case "${RUN_ARGS[$i]}" in
                -f|--file)        CREATE_ARGS+=("${RUN_ARGS[$i]}" "${RUN_ARGS[$((i+1))]}"); i=$((i+2)) ;;
                -n|-w|--name|--workflow) CREATE_ARGS+=("${RUN_ARGS[$i]}" "${RUN_ARGS[$((i+1))]}"); i=$((i+2)) ;;
                --skip-validation) CREATE_ARGS+=("${RUN_ARGS[$i]}"); i=$((i+1)) ;;
                -p|--parameter)   START_ARGS+=("${RUN_ARGS[$i]}" "${RUN_ARGS[$((i+1))]}"); i=$((i+2)) ;;
                -o|--option)      START_ARGS+=("${RUN_ARGS[$i]}" "${RUN_ARGS[$((i+1))]}"); i=$((i+2)) ;;
                --follow)         FOLLOW=true; i=$((i+1)) ;;
                *)                CREATE_ARGS+=("${RUN_ARGS[$i]}"); i=$((i+1)) ;;
            esac
        done

        info "Creating workflow..."
        WORKFLOW_NAME=$(pixi run -e reana reana-client create "${CREATE_ARGS[@]}" | tail -1)
        info "Workflow created: $WORKFLOW_NAME"

        info "Uploading files (failures are non-fatal)..."
        pixi run -e reana reana-client upload -w "$WORKFLOW_NAME" || true

        info "Starting workflow..."
        if [ "$FOLLOW" = true ]; then
            pixi run -e reana reana-client start -w "$WORKFLOW_NAME" "${START_ARGS[@]}" --follow
        else
            pixi run -e reana reana-client start -w "$WORKFLOW_NAME" "${START_ARGS[@]}"
        fi
    else
        pixi run -e reana reana-client "${ARGS[@]}"
    fi
    info "Execution finished successfully!"
}

# --- lxplus setup ---

run_lxplus_setup() {
    [[ $(hostname) != *lxplus* ]] && { error "lxplus-setup is only meaningful on lxplus."; exit 1; }
    local EOS_BASE="${BARISTA_EOS_BASE:-/eos/cms/store/group/phys_higgs/ttHbb/${USER}/4b}"
    info "Creating EOS scratch directories under ${EOS_BASE}..."
    mkdir -p "${EOS_BASE}/barista_scratch/condor_logs" 2>/dev/null \
        || warning "Could not create ${EOS_BASE}/barista_scratch (check your EOS permissions or set lxplus_eos_scratch in the runner config)"
    setup_lxplus_kerberos
    info "Checking that HTCondor workers can reach a Dask scheduler on this node (port 8786)..."
    lxplus_check_scheduler_port 8786 && info "Port 8786 on $(hostname) is reachable from other CERN hosts."
    local SITE="${BARISTA_LXPLUS_SITE:-$PWD/.lxplus_site}"
    if run_coffea "python -c 'import dask_lxplus'" >/dev/null 2>&1; then
        info "dask_lxplus is available in the analysis image."
    else
        info "dask_lxplus is missing from the analysis image: installing an interim copy into ${SITE}"
        mkdir -p "$SITE" || { error "Cannot create ${SITE} (AFS quota?). Set BARISTA_LXPLUS_SITE to another directory."; exit 1; }
        # --no-deps: dask-lxplus' unpinned dask requirement would otherwise shadow the image's dask
        run_coffea "pip install --no-cache-dir --disable-pip-version-check --no-deps --target $(readlink -f "$SITE") dask-lxplus==0.3.3" \
            || { error "pip install of dask-lxplus failed."; exit 1; }
        run_coffea "python -c 'import dask_lxplus; print(\"dask_lxplus:\", dask_lxplus.__file__)'"
    fi
    info "lxplus setup done. Create or renew your grid proxy with:"
    info "  $0 voms-proxy-init -voms cms -rfc --valid 168:00 -out proxy/x509_proxy"
}

