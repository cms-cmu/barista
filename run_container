# --- Host Detection & Setup ---
PIXI_DIR="$HOME/.pixi"
PROFILE_DIR="software/snakemake/profiles"

# Detect which cluster profile to use based on hostname
detect_cluster_profile() {
    local HOST
    HOST=$(hostname)
    case "$HOST" in
        *cmslpcgpu*) echo "lpc_gpu" ;;
        *cmslpc*)  echo "lpc" ;;
        *lxplus*)  echo "lxplus" ;;
        *falcon*)  echo "falcon" ;;
        *rogue*)   echo "rogue" ;;
        *runner*)  echo "ci" ;;
        *bridges2*|*psc*) echo "bridges2" ;;
        *)         echo "default" ;;
    esac
}

# Parse apptainer-args from a Snakemake profile config.yaml
parse_apptainer_args() {
    local CONFIG_FILE="$1"
    if [ -f "$CONFIG_FILE" ]; then
        local raw
        raw=$(sed -n 's/^apptainer-args:[[:space:]]*"\(.*\)"/\1/p' "$CONFIG_FILE")
        # Expand shell variables like ${USER} in bind paths
        raw="${raw//\$\{USER\}/$USER}"
        raw="${raw//\$USER/$USER}"
        echo "$raw"
    fi
}

setup_host_env() {
    # Compute workspace hash to isolate Dask schedulers per worktree/workspace
    WORKSPACE_HASH="${BARISTA_WORKSPACE_HASH:-$(python3 -c "import hashlib, os; print(hashlib.md5(os.path.abspath(os.path.dirname('$0')).encode('utf-8')).hexdigest()[:8])")}"

    local HOST
    HOST=$(hostname)
    CLUSTER_PROFILE=$(detect_cluster_profile)
    local PROFILE_CONFIG="${PROFILE_DIR}/${CLUSTER_PROFILE}/config.yaml"
    info "Determining configuration for hostname: $HOST (profile: $CLUSTER_PROFILE)"

    # Set default apptainer executable
    APPTAINER_CMD="apptainer"

    if [[ "$CLUSTER_PROFILE" == "bridges2" ]]; then
        # Resolve SIF files from shared directory if present, otherwise use CVMFS
        local SHARED_IMAGE_DIR="/ocean/projects/phy260026p/shared/images"
        if [ -f "${SHARED_IMAGE_DIR}/barista_latest.sif" ]; then
            COFFEA_IMAGE="${SHARED_IMAGE_DIR}/barista_latest.sif"
        else
            COFFEA_IMAGE=$(_resolve_cvmfs "$COFFEA_IMAGE")
        fi
        if [ -f "${SHARED_IMAGE_DIR}/barista_dev_coffea2025_latest.sif" ]; then
            DEV_COFFEA2025_IMAGE="${SHARED_IMAGE_DIR}/barista_dev_coffea2025_latest.sif"
        fi
        if [ -f "${SHARED_IMAGE_DIR}/combine-container_CMSSW_14_1_0_pre4-combine_v10.6.0-harvester_v3.1.0.sif" ]; then
            COMBINE_IMAGE="${SHARED_IMAGE_DIR}/combine-container_CMSSW_14_1_0_pre4-combine_v10.6.0-harvester_v3.1.0.sif"
        else
            COMBINE_IMAGE=$(_resolve_cvmfs "$COMBINE_IMAGE")
        fi
        if [ -f "${SHARED_IMAGE_DIR}/barista_classifier_latest.sif" ]; then
            CLASSIFIER_IMAGE="${SHARED_IMAGE_DIR}/barista_classifier_latest.sif"
        else
            CLASSIFIER_IMAGE=$(_resolve_cvmfs "$CLASSIFIER_IMAGE")
        fi

        if [ -f "${SHARED_IMAGE_DIR}/brilws-docker_latest.sif" ]; then
            BRILCALC_IMAGE="${SHARED_IMAGE_DIR}/brilws-docker_latest.sif"
        else
            BRILCALC_IMAGE=$(_resolve_cvmfs "$BRILCALC_IMAGE")
        fi
    fi

    # Parse bind paths from profile config
    local APPTAINER_ARGS
    APPTAINER_ARGS=$(parse_apptainer_args "$PROFILE_CONFIG")
    if [ -n "$APPTAINER_ARGS" ]; then
        # Convert -B flags to comma-separated APPTAINER_BINDPATH
        # Extract all paths after -B flags
        local BIND_PATHS=""
        local ARGS_ARRAY=($APPTAINER_ARGS)
        local i=0
        while [ $i -lt ${#ARGS_ARRAY[@]} ]; do
            if [ "${ARGS_ARRAY[$i]}" = "-B" ] && [ $((i+1)) -lt ${#ARGS_ARRAY[@]} ]; then
                [ -n "$BIND_PATHS" ] && BIND_PATHS="${BIND_PATHS},"
                BIND_PATHS="${BIND_PATHS}${ARGS_ARRAY[$((i+1))]}"
                i=$((i+2))
            else
                i=$((i+1))
            fi
        done
        export APPTAINER_BINDPATH="$BIND_PATHS"
    fi

    # Standard Cache Setup (using /tmp to be safe/fast)
    local CACHE_BASE="/tmp/$(whoami)"

    # Cluster-specific non-bind-path settings
    case "$HOST" in
        *cmslpc*)
            PIXI_DIR="/uscms_data/d3/${USER}/.pixi"
            if [ ! -d "$PIXI_DIR" ]; then
                info "LPC environment detected. Pixi will be installed in ${PIXI_DIR}"
            fi
            CACHE_BASE="/uscms_data/d3/${USER}"
            export APPTAINER_IGNORE_PROOT=1
            ;;
        *falcon*|*rogue*)
            CACHE_BASE="$HOME"
            ;;
        *lxplus*)
            # AFS home is 10 GB: keep the pixi environment on the (larger) work volume when it exists
            local _work_dir="/afs/cern.ch/work/${USER:0:1}/${USER}"
            [ -d "$_work_dir" ] && PIXI_DIR="${BARISTA_PIXI_DIR:-${_work_dir}/.pixi}"
            # Complete the binds parsed from the lxplus profile instead of overwriting them
            for _b in /afs /eos /cvmfs; do
                _bind_listed "$_b" || export APPTAINER_BINDPATH="${APPTAINER_BINDPATH:+${APPTAINER_BINDPATH},}${_b}"
            done
            ;;
        *falcon*|*rogue*)
            # 1. Basic Mounts
            if [[ $HOST == *falcon* ]]; then
                export APPTAINER_BINDPATH="${COMMON_BINDS},/home/export/"
            else
                export APPTAINER_BINDPATH="${COMMON_BINDS},/home/export/,/mnt/scratch/${USER}"
            fi
            
            # 2. SLURM CONFIG, USERS, & MUNGE (CRITICAL FIX)
            #    Added /run/munge and /var/run/munge so sbatch can authenticate
            export APPTAINER_BINDPATH="${APPTAINER_BINDPATH},/etc/slurm,/etc/passwd,/etc/group,/run/munge,/var/run/munge"

            # 3. QUARANTINE BINDS
            export APPTAINER_BINDPATH="${APPTAINER_BINDPATH},/usr:/host/usr,/lib:/host/lib,/lib64:/host/lib64"

            # 4. PLUGIN BIND
            export APPTAINER_BINDPATH="${APPTAINER_BINDPATH},/usr/lib/x86_64-linux-gnu/slurm-wlm"

            # 5. GENERATE WRAPPER (use shared filesystem so compute nodes can access it)
            WRAPPER_DIR="$HOME/.cache/barista/slurm_wrappers"
            mkdir -p "$WRAPPER_DIR"
            
            cat <<EOF > "${WRAPPER_DIR}/slurm_wrapper.sh"
#!/bin/bash
# Define Host Library Paths (Ubuntu/Debian specific)
HOST_LIBS="/host/lib/x86_64-linux-gnu:/host/usr/lib/x86_64-linux-gnu:/host/usr/lib/x86_64-linux-gnu/slurm-wlm:/host/lib64:/host/usr/lib64"

# Define Host Loader
if [ -f "/host/lib64/ld-linux-x86-64.so.2" ]; then
    LOADER="/host/lib64/ld-linux-x86-64.so.2"
else
    LOADER="/host/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2"
fi

# Target Binary
NAME=\$(basename "\$0")
BINARY="/host/usr/bin/\$NAME"

# Execute
exec "\$LOADER" --library-path "\$HOST_LIBS" "\$BINARY" "\$@"
EOF
            chmod +x "${WRAPPER_DIR}/slurm_wrapper.sh"

            # Create Symlinks
            for cmd in sbatch squeue scancel scontrol; do
                ln -sf "${WRAPPER_DIR}/slurm_wrapper.sh" "${WRAPPER_DIR}/${cmd}"
            done

            # 6. Add wrappers to PATH (Must be FIRST)
            export APPTAINER_BINDPATH="${APPTAINER_BINDPATH},${WRAPPER_DIR}:/opt/slurm_wrappers"
            export APPTAINERENV_PATH="/opt/slurm_wrappers:\${PATH}"
            export SINGULARITYENV_PATH="/opt/slurm_wrappers:\${PATH}"
            
            # 7. Enable Slurm Mode if we aren't already in a job
            if [ -z "$SLURM_JOB_ID" ]; then
                export USE_SLURM=true 
            fi
            ;;
        *)
            if [ -z "$APPTAINER_ARGS" ]; then
                warning "Unknown hostname. Using defaults (HOME) for cache/config."
                CACHE_BASE=$HOME
                mkdir -p "$CACHE_BASE"
            fi
            ;;
    esac

    # Cache Configuration
    export APPTAINER_CACHEDIR="${CACHE_BASE}/apptainer_cache"
    export APPTAINER_TMPDIR="/tmp/$(whoami)/.apptainer/"
    export MPLCONFIGDIR="${CACHE_BASE}/.config/matplotlib"
    mkdir -p "$APPTAINER_CACHEDIR" "$APPTAINER_TMPDIR" "$MPLCONFIGDIR"
}

# --- LPC Specific Logic ---
setup_lpc_jobqueue() {
    # Only run on LPC
    [[ $(hostname) != *"cmslpc"* ]] && return 0

    # Bootstrap if missing or if outdated lpcjobqueue configuration is found
    if [[ ! -f ".bashrc" || ! -f ".cmslpc-local-conf" ]] || grep -q 'LPCJQ_VERSION="0.5' .bashrc 2>/dev/null; then
        info "Setting up/updating lpcjobqueue configuration..."
        rm -rf .env .bashrc .cmslpc-local-conf
        curl -OL https://raw.githubusercontent.com/CoffeaTeam/lpcjobqueue/main/bootstrap.sh
        bash bootstrap.sh
        rm -f bootstrap.sh shell
    else
        info "lpcjobqueue configuration found. Skipping bootstrap."
    fi

    # Define LPC specific variables and binds
    local LPC_CONDOR_CONFIG="/etc/condor/config.d/01_cmslpc_interactive"
    local LPC_CONDOR_LOCAL="/usr/local/bin/cmslpc-local-conf.py"
    
